# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000
HOST=0.0.0.0
SECRET_KEY=smarttemp-secret-key-development

# PostgreSQL Database Configuration
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smarttemp_db
# PostgreSQL Connection URI with psycopg 3 driver:
DATABASE_URL=postgresql+psycopg://postgres:your_password_here@localhost:5432/smarttemp_db

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Alert Threshold Defaults (Configurable Examples)
ALERT_TEMP_HIGH=35.0
ALERT_TEMP_LOW=15.0
ALERT_HUMIDITY_HIGH=80.0
ALERT_HUMIDITY_LOW=30.0
