# ==========================================
# SmartTemp Docker Environment Variables Template
# Copy this file to .env before running docker compose (optional)
# ==========================================

# Database Settings
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=smarttemp_db
DB_PORT=5432

# Backend Settings
BACKEND_PORT=5000
FLASK_DEBUG=False
SECRET_KEY=smarttemp-production-secret-change-in-prod
CORS_ORIGINS=*
SEED_DEMO_DATA=false

# Alert Threshold Defaults
ALERT_TEMP_HIGH=35.0
ALERT_TEMP_LOW=15.0
ALERT_HUMIDITY_HIGH=80.0
ALERT_HUMIDITY_LOW=30.0

# Frontend Settings
FRONTEND_PORT=5173
